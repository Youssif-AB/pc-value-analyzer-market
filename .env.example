APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://pcvalue:pcvalue@postgres:5432/pcvalue
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=pc-value-analyzer
MODEL_NAME=pc-value-regressor
MODEL_ALIAS=champion
MODEL_ARTIFACT_PATH=/app/backend/artifacts/price_model.joblib
MODEL_METADATA_PATH=/app/backend/artifacts/model_metadata.json
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8001

# Host ports for local Docker Compose. Change these if another project already uses a port.
WEB_HOST_PORT=8080
API_HOST_PORT=8001
MLFLOW_HOST_PORT=5001
PREFECT_HOST_PORT=4200
POSTGRES_HOST_PORT=5432

# Live market evidence. Leave a source blank to disable only that source.
LIVE_MARKET_ENABLED=true
MARKET_CURRENCY=CAD
LIVE_COMP_MAX_AGE_HOURS=72
LIVE_COMP_MAX_RESULTS=12
LIVE_COMP_MIN_SIMILARITY=0.52
LIVE_COMP_BLEND_CAP=0.68
MARKET_CACHE_TTL_HOURS=24
MARKET_REFRESH_TOKEN=change-me-for-any-public-deployment

# eBay Developers Program application credentials (Browse API / client credentials OAuth).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_CA
EBAY_CATEGORY_ID=179
EBAY_SEARCH_QUERIES=gaming desktop,rtx gaming pc,custom gaming pc
EBAY_RESULT_LIMIT=50

# Best Buy Developer API key (Products + Buying Options/Open Box APIs).
BESTBUY_API_KEY=
BESTBUY_CATEGORY_ID=pcmcat287600050002
BESTBUY_RESULT_LIMIT=100
BANK_OF_CANADA_FX_ENABLED=true
USD_TO_CAD_OVERRIDE=
